<Project>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformProject>true</IsTestingPlatformProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <TestingPLatformCaptureOutput>false</TestingPLatformCaptureOutput>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <MSpecImplicitUsings>true</MSpecImplicitUsings>
    <EnableMSpecSourceGeneration Condition="'$(EnableMSpecSourceGeneration)' == ''">true</EnableMSpecSourceGeneration>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="EnableMSpecSourceGeneration" />
  </ItemGroup>

  <ItemGroup>
    <TestingPlatformBuilderHook Include="F51AE038-9A32-4C84-A803-871ED565AA85">
      <DisplayName>MSpec</DisplayName>
      <TypeFullName>Machine.Specifications.Framework.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

</Project>
